generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
  engineType    = "library"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id            String            @id @default(cuid())
  email         String            @unique
  password      String
  name          String?
  role          Role              @default(ADMIN)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  lastLogin     DateTime?
  permissions   String[]          @default([])
  isActive      Boolean           @default(true)
  deletedAt     DateTime?
  articles      Article[]
  auditLogs     AuditLog[]
  userSessions  UserSession[]

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@index([lastLogin])
}

// Account, Session, VerificationToken tabloları silindi (boş, kullanılmıyor)

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  articles    Article[]

  @@index([slug])
  @@index([name])
  @@index([order])
}

model Article {
  id                        String                    @id @default(cuid())
  title                     String
  slug                      String                    @unique
  excerpt                   String
  content                   String
  imageUrl                  String?
  sourceUrl                 String?
  status                    ArticleStatus             @default(DRAFT)
  views                     Int                       @default(0)
  publishedAt               DateTime?
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  categoryId                String
  authorId                  String?
  agentLogId                String?
  metaTitle                 String?
  metaDescription           String?
  keywords                  String[]
  indexNowStatus            IndexStatus               @default(PENDING)
  indexedAt                 DateTime?
  score                     Int                       @default(0)
  seoScore                  Int?
  facebookShared            Boolean                   @default(false)
  readingTime               Int?                      @default(0)
  imageUrlMedium            String?
  imageUrlSmall             String?
  imageUrlThumb             String?
  topic                     String?
  titleEn                   String?
  excerptEn                 String?
  contentEn                 String?
  metaDescriptionEn         String?
  trendScore                Int?                      @default(0)
  isTrending                Boolean                   @default(false)
  keywordsEn                String[]                  @default([])
  googleIndexStatus         String?                   @default("PENDING")
  googleIndexedAt           DateTime?
  indexNowStatusEn          String?                   @default("PENDING")
  indexedAtEn               DateTime?
  googleIndexStatusEn       String?                   @default("PENDING")
  googleIndexedAtEn         DateTime?
  language                  String                    @default("tr")
  googleIndexed             Boolean                   @default(false)
  googleIndexingScheduled   Boolean                   @default(false)
  googleIndexingScheduledAt DateTime?
  indexNowSubmittedAt       DateTime?
  indexNowRetryCount        Int                       @default(0)
  
  // Relations
  interactions              ArticleInteraction[]
  indexNowNextRetryAt       DateTime?
  indexNowLastError         String?
  googleIndexRetryCount     Int                       @default(0)
  googleIndexNextRetryAt    DateTime?
  googleIndexLastError      String?
  agentLog                  AgentLog?                 @relation(fields: [agentLogId], references: [id])
  author                    User?                     @relation(fields: [authorId], references: [id])
  category                  Category                  @relation(fields: [categoryId], references: [id])
  analytics                 ArticleAnalytics[]
  translations              ArticleTranslation[]
  seoRecommendations        SEORecommendation[]
  duplicatesAsOriginal      ArticleDuplicate[]        @relation("OriginalArticle")
  duplicatesAsDuplicate     ArticleDuplicate[]        @relation("DuplicateArticle")
  socialShares              SocialShare[]
  trendMatches              TrendArticleMatch[]       // Trend eşleşmeleri

  @@index([slug])
  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([publishedAt])
  @@index([indexNowStatus])
  @@index([topic])
  @@index([topic, publishedAt(sort: Desc)])
  @@index([language])
  @@index([googleIndexed, language])
  @@index([googleIndexStatusEn])
  @@index([googleIndexStatus, googleIndexNextRetryAt])
  @@index([googleIndexStatus])
  @@index([googleIndexStatus, publishedAt])
  @@index([googleIndexedAtEn])
  @@index([indexNowStatusEn])
  @@index([indexNowStatus, indexNowNextRetryAt])
  @@index([indexedAtEn])
  @@index([status, googleIndexStatusEn])
  @@index([status, googleIndexStatus])

  // =============================================
  // FAZ 4: Database Optimizasyonu
  // =============================================

  // 1. GIN index for keywords - Array contains query performansı
  @@index([keywords], type: Gin, map: "idx_article_keywords_gin")
  @@index([keywordsEn], type: Gin, map: "idx_article_keywords_en_gin")

  // 2. Full-text search support - Migration ile ekleniyor (Prisma FullText type desteklemiyor)
  // 3. Partial index PUBLISHED - Migration ile ekleniyor (Prisma where clause desteklemiyor)
  // 4. Composite indexes - Çoklu sorgu optimizasyonu
  @@index([status, publishedAt(sort: Desc), language], map: "idx_article_status_published_lang")
  @@index([isTrending, trendScore(sort: Desc)], map: "idx_article_trending_score")
}

model ArticleInteraction {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  type      String   // "LIKE", "RATING", "VIEW"
  value     Int?     // RATING için 1-5 arası puan
  ipAddress String?  // Anonim kontrol için
  userAgent String?
  createdAt DateTime @default(now())

  @@index([articleId])
  @@index([ipAddress, articleId, type])
}

// View tracking with session control (5-minute deduplication)
model ArticleView {
  id        String   @id @default(cuid())
  articleId String
  sessionId String   // IP + UserAgent hash
  ipAddress String?  // Direct IP address for geolocation
  viewedAt  DateTime @default(now())

  @@index([articleId])
  @@index([sessionId, articleId, viewedAt])
  @@index([viewedAt])
  @@index([ipAddress])
}

model ArticleTranslation {
  id              String   @id @default(cuid())
  articleId       String
  locale          String
  title           String
  slug            String
  excerpt         String?
  content         String
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  article         Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, locale])
  @@unique([slug, locale])
  @@index([locale])
  @@index([articleId])
  @@index([articleId, locale])
  @@index([locale, slug])
}

model ArticleAnalytics {
  id          String   @id @default(cuid())
  articleId   String
  ipAddress   String
  userAgent   String?
  duration    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  country     String?
  countryCode String?
  region      String?
  city        String?
  latitude    Float?
  longitude   Float?
  // New fields
  scrollDepth Int      @default(0) // Max scroll percentage 0-100
  device      String?  // Desktop, Mobile, Tablet
  browser     String?  // Chrome, Firefox, Safari
  os          String?  // Windows, macOS, Linux
  referrer    String?  // Traffic source
  screenWidth Int?     // Viewport width
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([createdAt])
  @@index([ipAddress])
  @@index([country])
  @@index([city])
  @@index([articleId, createdAt(sort: Desc)])
  @@index([device])
  @@index([referrer])
}

model AgentLog {
  id              String      @id @default(cuid())
  executionTime   DateTime    @default(now())
  status          AgentStatus
  articlesCreated Int         @default(0)
  articlesScraped Int         @default(0)
  duration        Int?
  errors          String[]
  metadata        Json?
  progressUpdates Json?       @default("[]")
  articles        Article[]

  @@index([executionTime])
  @@index([status])
  @@index([status, executionTime(sort: Desc)])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  encrypted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

model AIGlossaryTerm {
  id             String   @id @default(cuid())
  term           String
  normalizedTerm String   @unique
  description    String
  aliases        String[] @default([])
  source         String   @default("SYSTEM")
  confidence     Float?
  usageCount     Int      @default(0)
  isActive       Boolean  @default(true)
  lastSeenAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([term])
  @@index([isActive])
  @@index([usageCount])
  @@index([lastSeenAt])
  @@index([source])
}

model SocialMedia {
  id        String   @id @default(cuid())
  platform  String   @unique
  url       String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([platform])
}

model Newsletter {
  id             String             @id @default(cuid())
  email          String             @unique
  status         SubscriptionStatus @default(ACTIVE)
  token          String             @unique @default(cuid())
  subscribedAt   DateTime           @default(now())
  unsubscribedAt DateTime?
  lastSentAt     DateTime?
  frequency      EmailFrequency     @default(DAILY)
  categories     String[]
  source         String?
  ipAddress      String?
  userAgent      String?

  @@index([email])
  @@index([status])
  @@index([token])
}

model PushSubscription {
  id           String   @id @default(cuid())
  endpoint     String   @unique
  keys         Json
  userAgent    String?
  ipAddress    String?
  subscribedAt DateTime @default(now())
  lastUsedAt   DateTime @default(now())
  language     String   @default("tr")

  @@index([endpoint])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  isRead    Boolean  @default(false)
  isReplied Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isRead])
  @@index([createdAt(sort: Desc)])
}

model Visitor {
  id           String      @id @default(cuid())
  visitorToken String      @unique
  ipAddress    String
  userAgent    String?
  currentPage  String
  country      String?
  countryCode  String?
  city         String?
  region       String?
  lastActivity DateTime    @default(now())
  createdAt    DateTime    @default(now())
  isp          String?
  latitude     Float?
  longitude    Float?
  timezone     String?
  provider     String?
  // New fields
  device       String?     // Desktop, Mobile, Tablet
  browser      String?     // Chrome, Firefox, Safari, Edge
  os           String?     // Windows, macOS, Linux, Android, iOS
  totalVisits  Int         @default(1)
  lastReferrer String?
  pageViews    PageView[]

  @@index([ipAddress])
  @@index([lastActivity])
  @@index([createdAt])
  @@index([country])
  @@index([device])
  @@index([browser])
}

// Detailed page view tracking - every single page visit
model PageView {
  id          String   @id @default(cuid())
  visitorId   String
  visitor     Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  path        String   // URL path visited
  referrer    String?  // Where they came from
  duration    Int      @default(0) // Seconds spent on page
  scrollDepth Int      @default(0) // Max scroll percentage (0-100)
  articleId   String?  // If it's an article page
  device      String?  // Desktop, Mobile, Tablet
  browser     String?  // Chrome, Firefox, etc.
  os          String?  // Windows, macOS, etc.
  screenWidth Int?     // Viewport width
  country     String?
  countryCode String?
  city        String?
  exitPage    Boolean  @default(false) // Was this the last page?
  bounced     Boolean  @default(false) // Left without interaction?
  createdAt   DateTime @default(now())

  @@index([visitorId])
  @@index([path])
  @@index([articleId])
  @@index([createdAt])
  @@index([createdAt, path])
  @@index([country])
  @@index([device])
  @@index([visitorId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  resource   String
  resourceId String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt(sort: Desc)])
}

// ArticleTemplate silindi (boş, kullanılmıyor)

model SEORecommendation {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  articleId  String    @db.VarChar(36)
  type       String    @db.VarChar(100)
  severity   String    @db.VarChar(50)
  message    String
  suggestion String?
  isResolved Boolean?  @default(false)
  createdAt  DateTime? @default(now()) @db.Timestamp(6)
  article    Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, isResolved, severity])
  @@index([type, severity, isResolved])
  @@index([articleId], map: "idx_seo_article")
  @@index([severity], map: "idx_seo_severity")
}

model ArticleDuplicate {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  originalId      String    @db.VarChar(36)
  duplicateId     String    @db.VarChar(36)
  similarityScore Decimal   @db.Decimal(5, 2)
  status          String?   @default("pending") @db.VarChar(50)
  mergedAt        DateTime? @db.Timestamp(6)
  mergedBy        String?   @db.VarChar(36)
  createdAt       DateTime? @default(now()) @db.Timestamp(6)
  original        Article   @relation("OriginalArticle", fields: [originalId], references: [id], onDelete: Cascade)
  duplicate       Article   @relation("DuplicateArticle", fields: [duplicateId], references: [id], onDelete: Cascade)

  @@index([duplicateId], map: "idx_duplicate_duplicate")
  @@index([originalId], map: "idx_duplicate_original")
  @@index([status], map: "idx_duplicate_status")
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  ipAddress    String
  userAgent    String?
  country      String?
  city         String?
  device       String?
  browser      String?
  os           String?
  isActive     Boolean  @default(true)
  lastActivity DateTime @default(now())
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
  @@index([isActive])
  @@index([lastActivity])
  @@index([expiresAt])
  @@index([userId, isActive])
}

model SystemMetric {
  id         String   @id @default(cuid())
  metricType String
  value      Float
  unit       String
  metadata   Json?
  timestamp  DateTime @default(now())

  @@index([metricType])
  @@index([timestamp(sort: Desc)])
  @@index([metricType, timestamp])
}

model ErrorLog {
  id         String    @id @default(cuid())
  level      String
  message    String
  stack      String?
  context    Json?
  userId     String?
  ipAddress  String?
  userAgent  String?
  url        String?
  method     String?
  statusCode Int?
  resolved   Boolean   @default(false)
  resolvedAt DateTime?
  resolvedBy String?
  createdAt  DateTime  @default(now())

  @@index([level])
  @@index([resolved])
  @@index([createdAt(sort: Desc)])
  @@index([userId])
  @@index([level, resolved])
}

// BatchOperation silindi (boş, kullanılmıyor)

// FilterPreset silindi (boş, kullanılmıyor)

model SearchProviderMetric {
  id              String   @id @default(cuid())
  provider        String
  timestamp       DateTime @default(now())
  requests        Int      @default(0)
  errors          Int      @default(0)
  avgResponseTime Float?
  available       Boolean  @default(true)

  @@index([provider, timestamp])
  @@index([timestamp])
}

