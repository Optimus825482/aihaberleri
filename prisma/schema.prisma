enum Role {
  ADMIN
  EDITOR
  SUPER_ADMIN
  VIEWER
  MODERATOR
}

enum IndexStatus {
  PENDING
  SUBMITTED
  FAILED
  SCHEDULED
  RATE_LIMITED
  SKIPPED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AgentStatus {
  RUNNING
  SUCCESS
  FAILED
  PARTIAL
}

enum SubscriptionStatus {
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
  COMPLAINED
}

enum EmailFrequency {
  REALTIME
  DAILY
  WEEKLY
  MONTHLY
}

enum IndexAction {
  SUBMIT
  UPDATE
  REMOVE
}

enum IndexType {
  INDEXNOW
  GOOGLE
}

// =============================================
// Social Media Share Tracking
// =============================================

// Social Media Share Tracking - Her platform için ayrı kayıt
model SocialShare {
  id          String         @id @default(cuid())
  articleId   String
  platform    SocialPlatform
  language    String         @default("tr") // "tr" or "en" - hangi dilde paylaşıldı
  status      ShareStatus    @default(PENDING)
  postId      String?        // Platform'dan dönen post ID
  postUrl     String?        // Paylaşım URL'i
  error       String?        @db.Text
  retryCount  Int            @default(0)
  scheduledAt DateTime?      // Batch için planlanmış zaman
  sharedAt    DateTime?      // Paylaşıldığı zaman
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, platform, language]) // Her makale+platform+dil için tek kayıt
  @@index([platform])
  @@index([status])
  @@index([language])
  @@index([scheduledAt])
  @@index([articleId, platform])
}

// Social Share Batch - Toplu paylaşım işleri
model SocialShareBatch {
  id              String         @id @default(cuid())
  platform        String         // Comma-separated platforms: "FACEBOOK,BLUESKY,MASTODON"
  language        String         @default("tr")
  batchSize       Int            @default(10)
  intervalMinutes Float          @default(5) // Paylaşımlar arası bekleme süresi (dakika)
  status          String         @default("PENDING") // "PENDING", "PROCESSING", "COMPLETED", "FAILED", "PAUSED"
  totalItems      Int
  processedItems  Int            @default(0)
  failedItems     Int            @default(0)
  scheduledFor    DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  error           String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
  @@index([scheduledFor])
}

enum SocialPlatform {
  FACEBOOK
  FACEBOOK_EN
  TWITTER
  BLUESKY
  BLUESKY_EN
  MASTODON
  MASTODON_EN
}

enum ShareStatus {
  PENDING
  SCHEDULED
  PROCESSING
  SHARED
  FAILED
  SKIPPED
}

// =============================================
// Social Media Trend Tracking
// =============================================

// Twitter & Reddit trend verileri (Dataset olarak saklanır)
model SocialTrend {
  id            String   @id @default(cuid())
  platform      String   // "twitter" | "reddit"
  topic         String   // Trend konusu
  hashtag       String?  // #hashtag (varsa)
  volume        Int      @default(0) // Tweet/Comment sayısı
  score         Int      @default(0) // Platform trend skoru (1-100)
  sentiment     String   @default("neutral") // "positive" | "negative" | "neutral"
  region        String   @default("TR") // "TR" | "US" | "global"
  language      String   @default("tr") // "tr" | "en"
  
  // Keywords for soft matching
  keywords      String[] // Extracted keywords for fuzzy matching
  
  // Metadata
  rank          Int?     // Trend sıralaması
  url           String?  // Trend URL (Reddit post, Twitter trend page)
  subreddit     String?  // Reddit için subreddit adı
  
  // Timestamps
  fetchedAt     DateTime @default(now())
  expiresAt     DateTime // fetchedAt + 1 hour
  
  // Relations
  snapshots     TrendSnapshot[]
  articleMatches TrendArticleMatch[]
  
  @@index([platform, region])
  @@index([topic])
  @@index([fetchedAt])
  @@index([expiresAt])
  @@index([platform, language])
  @@index([score(sort: Desc)])
}

// Trend tarihçesi (Dataset için - uzun süreli saklama)
model TrendSnapshot {
  id          String   @id @default(cuid())
  trendId     String
  trend       SocialTrend @relation(fields: [trendId], references: [id], onDelete: Cascade)
  
  volume      Int      // O anki tweet/comment sayısı
  score       Int      // O anki skor
  rank        Int      // O anki sıralama
  
  capturedAt  DateTime @default(now())
  
  @@index([trendId, capturedAt])
  @@index([capturedAt(sort: Desc)])
}

// Haber-Trend eşleşmeleri
model TrendArticleMatch {
  id              String   @id @default(cuid())
  articleId       String
  article         Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  trendId         String
  trend           SocialTrend @relation(fields: [trendId], references: [id], onDelete: Cascade)
  
  matchScore      Float    // 0-1 arası benzerlik skoru
  matchType       String   @default("keyword") // "keyword" | "hashtag" | "entity"
  matchedKeywords String[] // Eşleşen keyword'ler
  
  createdAt       DateTime @default(now())
  
  @@unique([articleId, trendId])
  @@index([articleId])
  @@index([trendId])
  @@index([matchScore(sort: Desc)])
}

// =============================================
// Tavily Credit Usage Tracking
// =============================================

// TavilyUsage silindi (boş, kullanılmıyor)

// =============================================
// YouTube Channel Monitoring
// =============================================

model YouTubeChannel {
  id              String   @id @default(cuid())
  channelId       String   @unique // YouTube channel ID (UCxxxx)
  name            String
  language        String   @default("en")
  category        String   @default("ai_news") // ai_news, ai_research, ai_tools, ai_business, ai_turkish
  priority        Int      @default(3) // 1-5
  isActive        Boolean  @default(true)
  thumbnailUrl    String?
  subscriberCount Int?
  lastFetchedAt   DateTime?
  lastVideoId     String?  // Son taranan video ID (duplicate önleme)
  totalVideos     Int      @default(0)
  failureCount    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive])
  @@index([category])
  @@index([priority(sort: Desc)])
  @@index([lastFetchedAt])
}

// =============================================
// Pipeline Tracing & Prompt Versioning
// =============================================

// Pipeline execution traces - her pipeline çalışmasının adım adım kaydı
model PipelineTrace {
  id            String          @id @default(cuid())
  agentLogId    String?         // İlişkili agent log
  pipelineName  String          // "news-pipeline", "seo-pipeline" etc.
  status        String          @default("RUNNING") // RUNNING, SUCCESS, FAILED, PARTIAL
  totalDuration Int?            // ms cinsinden toplam süre
  metadata      Json?           // Ek bilgiler
  createdAt     DateTime        @default(now())
  completedAt   DateTime?
  spans         PipelineSpan[]

  @@index([pipelineName])
  @@index([status])
  @@index([createdAt])
  @@index([agentLogId])
}

// Pipeline span - her adımın detaylı kaydı
model PipelineSpan {
  id            String        @id @default(cuid())
  traceId       String
  trace         PipelineTrace @relation(fields: [traceId], references: [id], onDelete: Cascade)
  parentSpanId  String?       // Nested span desteği
  name          String        // "rss-fetch", "deepseek-rewrite", "image-generate" etc.
  status        String        @default("RUNNING") // RUNNING, SUCCESS, FAILED
  duration      Int?          // ms
  startedAt     DateTime      @default(now())
  completedAt   DateTime?
  attributes    Json?         // { model: "deepseek-chat", tokens: 1500, promptVersion: "v2" }
  error         String?       // Hata mesajı (varsa)

  @@index([traceId])
  @@index([name])
  @@index([status])
  @@index([startedAt])
}

// Prompt versioning - DeepSeek prompt'larının versiyonlanması
model PromptVersion {
  id            String   @id @default(cuid())
  name          String   // "article-rewrite", "article-analyze", "image-prompt", "translation"
  version       String   // "v1", "v2", "v3"
  isActive      Boolean  @default(false) // Aktif versiyon
  systemPrompt  String   @db.Text
  userTemplate  String   @db.Text // {{title}}, {{content}} gibi placeholder'lar
  config        Json?    // { temperature: 0.7, maxTokens: 4000, model: "deepseek-chat" }
  description   String?  // Değişiklik açıklaması
  metrics       Json?    // { avgScore: 820, usageCount: 150, avgDuration: 3200 }
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([name, version])
  @@index([name, isActive])
  @@index([name])
}

// =============================================
// AdSense Revenue Tracking & AI Analysis
// =============================================

// Günlük AdSense gelir snapshot'ları
model AdSenseSnapshot {
  id              String   @id @default(cuid())
  date            DateTime @db.Date // Hangi gün
  earnings        Float    // O günkü kazanç (USD cents → dolar olarak)
  clicks          Int      @default(0)
  impressions     Int      @default(0)
  pageViews       Int      @default(0)
  ctr             Float    @default(0) // Click-through rate
  cpc             Float    @default(0) // Cost per click
  rpm             Float    @default(0) // Revenue per mille (1000 impression)
  pageRpm         Float    @default(0) // Page RPM
  // Ek metrikler
  adUnits         Json?    // Reklam birimi bazlı dağılım
  countries       Json?    // Ülke bazlı gelir dağılımı
  pages           Json?    // Sayfa bazlı gelir dağılımı
  createdAt       DateTime @default(now())

  @@unique([date])
  @@index([date(sort: Desc)])
  @@index([createdAt])
}

// AI destekli AdSense analiz sonuçları
model AdSenseAnalysis {
  id              String   @id @default(cuid())
  // Analiz zamanındaki metrik snapshot'ı
  metricsSnapshot Json     // { todayEarnings, monthEarnings, totalEarnings, rpm, ctr, cpc, ... }
  // AI analiz sonucu
  analysis        String   @db.Text // AI'ın ürettiği detaylı analiz
  recommendations Json     // [{ type, priority, title, description, expectedImpact }]
  warnings        Json?    // [{ type, severity, message, metric, value }]
  // Durumu
  status          String   @default("COMPLETED") // PENDING, COMPLETED, FAILED
  aiModel         String   @default("deepseek") // Hangi model kullanıldı
  aiDuration      Int?     // ms cinsinden AI yanıt süresi
  // Kullanıcı aksiyonları
  reviewedAt      DateTime? // Kullanıcı ne zaman inceledi
  reviewNotes     String?   @db.Text // İnceleme notları
  actionsApplied  Json?     // Hangi tavsiyeler uygulandı
  createdAt       DateTime  @default(now())

  @@index([createdAt(sort: Desc)])
  @@index([status])
}
