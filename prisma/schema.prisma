generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x", "debian-openssl-3.0.x"]
  engineType    = "library"
}

datasource db {
  provider     = "postgresql"
  url          = env("DATABASE_URL")
  relationMode = "prisma"
}

model User {
  id            String            @id @default(cuid())
  email         String            @unique
  password      String
  name          String?
  role          Role              @default(ADMIN)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  lastLogin     DateTime?
  permissions   String[]          @default([])
  isActive      Boolean           @default(true)
  deletedAt     DateTime?
  accounts      Account[]
  articles      Article[]
  sessions      Session[]
  auditLogs     AuditLog[]
  templates     ArticleTemplate[]
  userSessions  UserSession[]
  filterPresets FilterPreset[]

  @@index([email])
  @@index([role])
  @@index([isActive])
  @@index([lastLogin])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  articles    Article[]

  @@index([slug])
  @@index([name])
  @@index([order])
}

model Article {
  id                        String                    @id @default(cuid())
  title                     String
  slug                      String                    @unique
  excerpt                   String
  content                   String
  imageUrl                  String?
  sourceUrl                 String?
  status                    ArticleStatus             @default(DRAFT)
  views                     Int                       @default(0)
  publishedAt               DateTime?
  createdAt                 DateTime                  @default(now())
  updatedAt                 DateTime                  @updatedAt
  categoryId                String
  authorId                  String?
  agentLogId                String?
  metaTitle                 String?
  metaDescription           String?
  keywords                  String[]
  indexNowStatus            IndexStatus               @default(PENDING)
  indexedAt                 DateTime?
  score                     Int                       @default(0)
  facebookShared            Boolean                   @default(false)
  seoScore                  Int?                      @default(0)
  readingTime               Int?                      @default(0)
  scheduledPublishAt        DateTime?                 @db.Timestamp(6)
  templateId                String?                   @db.VarChar(36)
  imageUrlMedium            String?
  imageUrlSmall             String?
  imageUrlThumb             String?
  topic                     String?
  titleEn                   String?
  excerptEn                 String?
  contentEn                 String?
  metaDescriptionEn         String?
  sourceTitle               String?
  sourceDescription         String?
  trendScore                Int?                      @default(0)
  isTrending                Boolean                   @default(false)
  trendBadgeTr              String?                   // "🔥 Gündem"
  trendBadgeEn              String?                   // "🔥 Trending"
  trendHashtags             String[]                  @default([]) // Sosyal paylaşım için
  keywordsEn                String[]                  @default([])
  titleABTest               Json?
  embedding                 Json?
  googleIndexStatus         String?                   @default("PENDING")
  googleIndexedAt           DateTime?
  indexNowStatusEn          String?                   @default("PENDING")
  indexedAtEn               DateTime?
  googleIndexStatusEn       String?                   @default("PENDING")
  googleIndexedAtEn         DateTime?
  facebookSharedEn          Boolean?                  @default(false)
  language                  String                    @default("tr")
  googleIndexed             Boolean                   @default(false)
  googleIndexingScheduled   Boolean                   @default(false)
  googleIndexingScheduledAt DateTime?
  indexNowSubmittedAt       DateTime?
  indexNowRetryCount        Int                       @default(0)
  
  // Interaction Metrics
  likes                     Int                       @default(0)
  rating                    Float                     @default(0)
  ratingCount               Int                       @default(0)
  
  // Relations
  interactions              ArticleInteraction[]
  indexNowNextRetryAt       DateTime?
  indexNowLastError         String?
  googleIndexRetryCount     Int                       @default(0)
  googleIndexNextRetryAt    DateTime?
  googleIndexLastError      String?
  googleIndexBatchId        String?
  agentLog                  AgentLog?                 @relation(fields: [agentLogId], references: [id])
  author                    User?                     @relation(fields: [authorId], references: [id])
  category                  Category                  @relation(fields: [categoryId], references: [id])
  template                  ArticleTemplate?          @relation(fields: [templateId], references: [id], onDelete: SetNull)
  analytics                 ArticleAnalytics[]
  translations              ArticleTranslation[]
  seoRecommendations        SEORecommendation[]
  duplicatesAsOriginal      ArticleDuplicate[]        @relation("OriginalArticle")
  duplicatesAsDuplicate     ArticleDuplicate[]        @relation("DuplicateArticle")
  googleIndexingBatchItems  GoogleIndexingBatchItem[]
  socialShares              SocialShare[]
  trendMatches              TrendArticleMatch[]       // Trend eşleşmeleri

  @@index([slug])
  @@index([status, publishedAt])
  @@index([categoryId])
  @@index([publishedAt])
  @@index([indexNowStatus])
  @@index([topic])
  @@index([topic, publishedAt(sort: Desc)])
  @@index([language])
  @@index([googleIndexed, language])
  @@index([googleIndexBatchId])
  @@index([googleIndexStatusEn])
  @@index([googleIndexStatus, googleIndexNextRetryAt])
  @@index([googleIndexStatus])
  @@index([googleIndexStatus, publishedAt])
  @@index([googleIndexedAtEn])
  @@index([googleIndexedAt])
  @@index([googleIndexingScheduled])
  @@index([imageUrlMedium])
  @@index([imageUrlSmall])
  @@index([imageUrlThumb])
  @@index([indexNowStatusEn])
  @@index([indexNowStatus, indexNowNextRetryAt])
  @@index([indexedAtEn])
  @@index([status, googleIndexStatusEn])
  @@index([status, googleIndexStatus])
  @@index([seoScore], map: "idx_article_seo_score")

  // =============================================
  // FAZ 4: Database Optimizasyonu
  // =============================================

  // 1. GIN index for keywords - Array contains query performansı
  @@index([keywords], type: Gin, map: "idx_article_keywords_gin")
  @@index([keywordsEn], type: Gin, map: "idx_article_keywords_en_gin")

  // 2. Full-text search support - Migration ile ekleniyor (Prisma FullText type desteklemiyor)
  // 3. Partial index PUBLISHED - Migration ile ekleniyor (Prisma where clause desteklemiyor)
  // 4. Composite indexes - Çoklu sorgu optimizasyonu
  @@index([status, publishedAt(sort: Desc), language], map: "idx_article_status_published_lang")
  @@index([isTrending, trendScore(sort: Desc)], map: "idx_article_trending_score")
}

model ArticleInteraction {
  id        String   @id @default(cuid())
  articleId String
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  type      String   // "LIKE", "RATING", "VIEW"
  value     Int?     // RATING için 1-5 arası puan
  ipAddress String?  // Anonim kontrol için
  userAgent String?
  createdAt DateTime @default(now())

  @@index([articleId])
  @@index([ipAddress, articleId, type])
}

// View tracking with session control (5-minute deduplication)
model ArticleView {
  id        String   @id @default(cuid())
  articleId String
  sessionId String   // IP + UserAgent hash
  ipAddress String?  // Direct IP address for geolocation
  viewedAt  DateTime @default(now())

  @@index([articleId])
  @@index([sessionId, articleId, viewedAt])
  @@index([viewedAt])
  @@index([ipAddress])
}

model ArticleTranslation {
  id              String   @id @default(cuid())
  articleId       String
  locale          String
  title           String
  slug            String
  excerpt         String?
  content         String
  metaTitle       String?
  metaDescription String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  article         Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, locale])
  @@unique([slug, locale])
  @@index([locale])
  @@index([articleId])
  @@index([articleId, locale])
  @@index([locale, slug])
}

model ArticleAnalytics {
  id          String   @id @default(cuid())
  articleId   String
  ipAddress   String
  userAgent   String?
  duration    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  country     String?
  countryCode String?
  region      String?
  city        String?
  latitude    Float?
  longitude   Float?
  // New fields
  scrollDepth Int      @default(0) // Max scroll percentage 0-100
  device      String?  // Desktop, Mobile, Tablet
  browser     String?  // Chrome, Firefox, Safari
  os          String?  // Windows, macOS, Linux
  referrer    String?  // Traffic source
  screenWidth Int?     // Viewport width
  article     Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId])
  @@index([createdAt])
  @@index([ipAddress])
  @@index([country])
  @@index([city])
  @@index([articleId, createdAt(sort: Desc)])
  @@index([device])
  @@index([referrer])
}

model AgentLog {
  id              String      @id @default(cuid())
  executionTime   DateTime    @default(now())
  status          AgentStatus
  articlesCreated Int         @default(0)
  articlesScraped Int         @default(0)
  duration        Int?
  errors          String[]
  metadata        Json?
  progressUpdates Json?       @default("[]")
  articles        Article[]

  @@index([executionTime])
  @@index([status])
  @@index([status, executionTime(sort: Desc)])
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  encrypted Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
}

model SocialMedia {
  id        String   @id @default(cuid())
  platform  String   @unique
  url       String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([platform])
}

model Newsletter {
  id             String             @id @default(cuid())
  email          String             @unique
  status         SubscriptionStatus @default(ACTIVE)
  token          String             @unique @default(cuid())
  subscribedAt   DateTime           @default(now())
  unsubscribedAt DateTime?
  lastSentAt     DateTime?
  frequency      EmailFrequency     @default(DAILY)
  categories     String[]
  source         String?
  ipAddress      String?
  userAgent      String?

  @@index([email])
  @@index([status])
  @@index([token])
}

model PushSubscription {
  id           String   @id @default(cuid())
  endpoint     String   @unique
  keys         Json
  userAgent    String?
  ipAddress    String?
  subscribedAt DateTime @default(now())
  lastUsedAt   DateTime @default(now())
  language     String   @default("tr")

  @@index([endpoint])
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  isRead    Boolean  @default(false)
  isReplied Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isRead])
  @@index([createdAt(sort: Desc)])
}

model Visitor {
  id           String      @id @default(cuid())
  ipAddress    String      @unique
  userAgent    String?
  currentPage  String
  country      String?
  countryCode  String?
  city         String?
  region       String?
  lastActivity DateTime    @default(now())
  createdAt    DateTime    @default(now())
  isp          String?
  latitude     Float?
  longitude    Float?
  timezone     String?
  provider     String?
  // New fields
  device       String?     // Desktop, Mobile, Tablet
  browser      String?     // Chrome, Firefox, Safari, Edge
  os           String?     // Windows, macOS, Linux, Android, iOS
  totalVisits  Int         @default(1)
  lastReferrer String?
  pageViews    PageView[]

  @@index([ipAddress])
  @@index([lastActivity])
  @@index([createdAt])
  @@index([country])
  @@index([device])
  @@index([browser])
}

// Detailed page view tracking - every single page visit
model PageView {
  id          String   @id @default(cuid())
  visitorId   String
  visitor     Visitor  @relation(fields: [visitorId], references: [id], onDelete: Cascade)
  path        String   // URL path visited
  referrer    String?  // Where they came from
  duration    Int      @default(0) // Seconds spent on page
  scrollDepth Int      @default(0) // Max scroll percentage (0-100)
  articleId   String?  // If it's an article page
  device      String?  // Desktop, Mobile, Tablet
  browser     String?  // Chrome, Firefox, etc.
  os          String?  // Windows, macOS, etc.
  screenWidth Int?     // Viewport width
  country     String?
  countryCode String?
  city        String?
  exitPage    Boolean  @default(false) // Was this the last page?
  bounced     Boolean  @default(false) // Left without interaction?
  createdAt   DateTime @default(now())

  @@index([visitorId])
  @@index([path])
  @@index([articleId])
  @@index([createdAt])
  @@index([createdAt, path])
  @@index([country])
  @@index([device])
  @@index([visitorId, createdAt])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String
  action     String
  resource   String
  resourceId String?
  details    Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([action])
  @@index([resource])
  @@index([createdAt(sort: Desc)])
}

model ArticleTemplate {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  name        String    @db.VarChar(255)
  description String?
  content     String
  category    String?   @db.VarChar(100)
  isActive    Boolean?  @default(true)
  usageCount  Int?      @default(0)
  createdBy   String    @db.VarChar(36)
  createdAt   DateTime? @default(now()) @db.Timestamp(6)
  updatedAt   DateTime? @default(now()) @updatedAt @db.Timestamp(6)
  creator     User      @relation(fields: [createdBy], references: [id], onDelete: Cascade)
  articles    Article[]

  @@index([createdBy], map: "idx_template_creator")
}

model SEORecommendation {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  articleId  String    @db.VarChar(36)
  type       String    @db.VarChar(100)
  severity   String    @db.VarChar(50)
  message    String
  suggestion String?
  isResolved Boolean?  @default(false)
  createdAt  DateTime? @default(now()) @db.Timestamp(6)
  article    Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, isResolved, severity])
  @@index([type, severity, isResolved])
  @@index([articleId], map: "idx_seo_article")
  @@index([severity], map: "idx_seo_severity")
}

model ArticleDuplicate {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.VarChar(36)
  originalId      String    @db.VarChar(36)
  duplicateId     String    @db.VarChar(36)
  similarityScore Decimal   @db.Decimal(5, 2)
  status          String?   @default("pending") @db.VarChar(50)
  mergedAt        DateTime? @db.Timestamp(6)
  mergedBy        String?   @db.VarChar(36)
  createdAt       DateTime? @default(now()) @db.Timestamp(6)
  original        Article   @relation("OriginalArticle", fields: [originalId], references: [id], onDelete: Cascade)
  duplicate       Article   @relation("DuplicateArticle", fields: [duplicateId], references: [id], onDelete: Cascade)

  @@index([duplicateId], map: "idx_duplicate_duplicate")
  @@index([originalId], map: "idx_duplicate_original")
  @@index([status], map: "idx_duplicate_status")
}

model UserSession {
  id           String   @id @default(cuid())
  userId       String
  sessionToken String   @unique
  ipAddress    String
  userAgent    String?
  country      String?
  city         String?
  device       String?
  browser      String?
  os           String?
  isActive     Boolean  @default(true)
  lastActivity DateTime @default(now())
  expiresAt    DateTime
  createdAt    DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sessionToken])
  @@index([isActive])
  @@index([lastActivity])
  @@index([expiresAt])
  @@index([userId, isActive])
}

model SystemMetric {
  id         String   @id @default(cuid())
  metricType String
  value      Float
  unit       String
  metadata   Json?
  timestamp  DateTime @default(now())

  @@index([metricType])
  @@index([timestamp(sort: Desc)])
  @@index([metricType, timestamp])
}

model ErrorLog {
  id         String    @id @default(cuid())
  level      String
  message    String
  stack      String?
  context    Json?
  userId     String?
  ipAddress  String?
  userAgent  String?
  url        String?
  method     String?
  statusCode Int?
  resolved   Boolean   @default(false)
  resolvedAt DateTime?
  resolvedBy String?
  createdAt  DateTime  @default(now())

  @@index([level])
  @@index([resolved])
  @@index([createdAt(sort: Desc)])
  @@index([userId])
  @@index([level, resolved])
}

model BatchOperation {
  id             String    @id @default(cuid())
  operationType  String
  status         String    @default("pending")
  totalItems     Int
  processedItems Int       @default(0)
  successCount   Int       @default(0)
  failureCount   Int       @default(0)
  errors         Json?
  metadata       Json?
  startedAt      DateTime?
  completedAt    DateTime?
  createdBy      String
  createdAt      DateTime  @default(now())

  @@index([status])
  @@index([operationType])
  @@index([createdBy])
  @@index([createdAt(sort: Desc)])
  @@index([status, operationType])
}

model FilterPreset {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  filters     Json
  isDefault   Boolean  @default(false)
  isPublic    Boolean  @default(false)
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isDefault])
  @@index([isPublic])
}

model SearchProviderMetric {
  id              String   @id @default(cuid())
  provider        String
  timestamp       DateTime @default(now())
  requests        Int      @default(0)
  errors          Int      @default(0)
  avgResponseTime Float?
  available       Boolean  @default(true)

  @@index([provider, timestamp])
  @@index([timestamp])
}

model GoogleIndexingBatch {
  id                String                    @id @default(cuid())
  scheduledFor      DateTime
  status            String                    @default("PENDING")
  totalArticles     Int
  processedArticles Int                       @default(0)
  failedArticles    Int                       @default(0)
  startedAt         DateTime?
  completedAt       DateTime?
  error             String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  batchType         String                    @default("MANUAL")
  language          String                    @default("tr")
  submittedCount    Int                       @default(0)
  successCount      Int                       @default(0)
  failedCount       Int                       @default(0)
  skippedCount      Int                       @default(0)
  scheduledAt       DateTime?
  estimatedDuration Int?
  actualDuration    Int?
  rateLimitHit      Boolean                   @default(false)
  rateLimitResetAt  DateTime?
  requestsPerMinute Int                       @default(0)
  errors            Json?
  retryCount        Int                       @default(0)
  maxRetries        Int                       @default(3)
  nextRetryAt       DateTime?
  metadata          Json?
  createdBy         String?
  items             GoogleIndexingBatchItem[]

  @@index([scheduledFor])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@index([batchType])
  @@index([completedAt])
  @@index([createdBy])
  @@index([language])
  @@index([scheduledAt])
  @@index([startedAt])
  @@index([status, scheduledAt])
}

model GoogleIndexingBatchItem {
  id          String              @id @default(cuid())
  batchId     String
  articleId   String
  status      String              @default("PENDING")
  error       String?
  processedAt DateTime?
  createdAt   DateTime            @default(now())
  batch       GoogleIndexingBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  article     Article             @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([articleId])
  @@index([status])
}

model IndexingHistory {
  id             String      @id
  articleId      String
  batchId        String?
  indexType      IndexType
  action         IndexAction
  status         IndexStatus
  requestUrl     String?
  requestPayload Json?
  responseStatus Int?
  responseBody   Json?
  submittedAt    DateTime    @default(now())
  respondedAt    DateTime?
  duration       Int?
  errorCode      String?
  errorMessage   String?
  errorDetails   Json?
  retryAttempt   Int         @default(0)
  isRetry        Boolean     @default(false)
  originalId     String?
  userAgent      String?
  ipAddress      String?
  metadata       Json?

  @@index([articleId])
  @@index([articleId, indexType, submittedAt])
  @@index([batchId])
  @@index([indexType])
  @@index([status])
  @@index([status, submittedAt])
  @@index([submittedAt(sort: Desc)])
}

enum Role {
  ADMIN
  EDITOR
  SUPER_ADMIN
  VIEWER
  MODERATOR
}

enum IndexStatus {
  PENDING
  SUBMITTED
  FAILED
  SCHEDULED
  RATE_LIMITED
  SKIPPED
}

enum ArticleStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum AgentStatus {
  RUNNING
  SUCCESS
  FAILED
  PARTIAL
}

enum SubscriptionStatus {
  ACTIVE
  UNSUBSCRIBED
  BOUNCED
  COMPLAINED
}

enum EmailFrequency {
  REALTIME
  DAILY
  WEEKLY
  MONTHLY
}

enum BatchStatus {
  PENDING
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  PAUSED
}

enum BatchType {
  MANUAL
  SCHEDULED
  AUTO_PUBLISH
  RETRY
  BULK_UPDATE
}

enum IndexAction {
  SUBMIT
  UPDATE
  REMOVE
}

enum IndexType {
  INDEXNOW
  GOOGLE
}

// =============================================
// Social Media Share Tracking
// =============================================

// Social Media Share Tracking - Her platform için ayrı kayıt
model SocialShare {
  id          String         @id @default(cuid())
  articleId   String
  platform    SocialPlatform
  language    String         @default("tr") // "tr" or "en" - hangi dilde paylaşıldı
  status      ShareStatus    @default(PENDING)
  postId      String?        // Platform'dan dönen post ID
  postUrl     String?        // Paylaşım URL'i
  error       String?        @db.Text
  retryCount  Int            @default(0)
  scheduledAt DateTime?      // Batch için planlanmış zaman
  sharedAt    DateTime?      // Paylaşıldığı zaman
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@unique([articleId, platform, language]) // Her makale+platform+dil için tek kayıt
  @@index([platform])
  @@index([status])
  @@index([language])
  @@index([scheduledAt])
  @@index([articleId, platform])
}

// Social Share Batch - Toplu paylaşım işleri
model SocialShareBatch {
  id              String         @id @default(cuid())
  platform        String         // Comma-separated platforms: "FACEBOOK,BLUESKY,MASTODON"
  language        String         @default("tr")
  batchSize       Int            @default(10)
  intervalMinutes Float          @default(5) // Paylaşımlar arası bekleme süresi (dakika)
  status          String         @default("PENDING") // "PENDING", "PROCESSING", "COMPLETED", "FAILED", "PAUSED"
  totalItems      Int
  processedItems  Int            @default(0)
  failedItems     Int            @default(0)
  scheduledFor    DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  error           String?        @db.Text
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([status])
  @@index([scheduledFor])
}

enum SocialPlatform {
  FACEBOOK
  FACEBOOK_EN
  TWITTER
  BLUESKY
  BLUESKY_EN
  MASTODON
  MASTODON_EN
}

enum ShareStatus {
  PENDING
  SCHEDULED
  PROCESSING
  SHARED
  FAILED
  SKIPPED
}

// =============================================
// Social Media Trend Tracking
// =============================================

// Twitter & Reddit trend verileri (Dataset olarak saklanır)
model SocialTrend {
  id            String   @id @default(cuid())
  platform      String   // "twitter" | "reddit"
  topic         String   // Trend konusu
  hashtag       String?  // #hashtag (varsa)
  volume        Int      @default(0) // Tweet/Comment sayısı
  score         Int      @default(0) // Platform trend skoru (1-100)
  sentiment     String   @default("neutral") // "positive" | "negative" | "neutral"
  region        String   @default("TR") // "TR" | "US" | "global"
  language      String   @default("tr") // "tr" | "en"
  
  // Keywords for soft matching
  keywords      String[] // Extracted keywords for fuzzy matching
  
  // Metadata
  rank          Int?     // Trend sıralaması
  url           String?  // Trend URL (Reddit post, Twitter trend page)
  subreddit     String?  // Reddit için subreddit adı
  
  // Timestamps
  fetchedAt     DateTime @default(now())
  expiresAt     DateTime // fetchedAt + 1 hour
  
  // Relations
  snapshots     TrendSnapshot[]
  articleMatches TrendArticleMatch[]
  
  @@index([platform, region])
  @@index([topic])
  @@index([fetchedAt])
  @@index([expiresAt])
  @@index([platform, language])
  @@index([score(sort: Desc)])
}

// Trend tarihçesi (Dataset için - uzun süreli saklama)
model TrendSnapshot {
  id          String   @id @default(cuid())
  trendId     String
  trend       SocialTrend @relation(fields: [trendId], references: [id], onDelete: Cascade)
  
  volume      Int      // O anki tweet/comment sayısı
  score       Int      // O anki skor
  rank        Int      // O anki sıralama
  
  capturedAt  DateTime @default(now())
  
  @@index([trendId, capturedAt])
  @@index([capturedAt(sort: Desc)])
}

// Haber-Trend eşleşmeleri
model TrendArticleMatch {
  id              String   @id @default(cuid())
  articleId       String
  article         Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
  trendId         String
  trend           SocialTrend @relation(fields: [trendId], references: [id], onDelete: Cascade)
  
  matchScore      Float    // 0-1 arası benzerlik skoru
  matchType       String   @default("keyword") // "keyword" | "hashtag" | "entity"
  matchedKeywords String[] // Eşleşen keyword'ler
  
  createdAt       DateTime @default(now())
  
  @@unique([articleId, trendId])
  @@index([articleId])
  @@index([trendId])
  @@index([matchScore(sort: Desc)])
}

// =============================================
// Tavily Credit Usage Tracking
// =============================================

model TavilyUsage {
  id        String   @id @default(cuid())
  feature   String   // "search" | "extract" | "crawl" | "map" | "research"
  credits   Int      // Number of credits consumed
  timestamp DateTime @default(now())
  metadata  String?  // JSON metadata (optional)
  
  @@index([feature])
  @@index([timestamp(sort: Desc)])
  @@index([feature, timestamp])
}

// =============================================
// YouTube Channel Monitoring
// =============================================

model YouTubeChannel {
  id              String   @id @default(cuid())
  channelId       String   @unique // YouTube channel ID (UCxxxx)
  name            String
  language        String   @default("en")
  category        String   @default("ai_news") // ai_news, ai_research, ai_tools, ai_business, ai_turkish
  priority        Int      @default(3) // 1-5
  isActive        Boolean  @default(true)
  thumbnailUrl    String?
  subscriberCount Int?
  lastFetchedAt   DateTime?
  lastVideoId     String?  // Son taranan video ID (duplicate önleme)
  totalVideos     Int      @default(0)
  failureCount    Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isActive])
  @@index([category])
  @@index([priority(sort: Desc)])
  @@index([lastFetchedAt])
}
