# ========================================
# Coolify Production Environment Variables
# ========================================
# Bu dosya Coolify Dashboard → Environment sekmesine kopyalanmalıdır
# Her environment variable ekledikten sonra "Save" ve "Redeploy" yapın
# ========================================

# ========================================
# 🔴 KRİTİK (ZORUNLU)
# ========================================

# Database (Coolify-managed PostgreSQL)
# Coolify Dashboard → PostgreSQL → Internal URL kullan
# Format: postgresql://postgres:PASSWORD@postgres:5432/postgresainewsdb
DATABASE_URL=postgresql://postgres:STRONG_PASSWORD@postgres:5432/postgresainewsdb

# NextAuth
# Generate: openssl rand -base64 32
NEXTAUTH_SECRET=your-super-secret-key-here-min-32-chars
NEXTAUTH_URL=https://aihaberleri.org

# HaberCombo API (Primary LLM — custom model)
# Kendi LLM sunucunuz için base URL, API key ve model adı
HABERCOMBO_API_URL=http://77.42.68.4:20128/v1
HABERCOMBO_API_KEY=sk-f9f9298b6a77ac49-emuuy8-ba99e285
HABERCOMBO_MODEL=habercombo

# DeepSeek AI (Content Generation)
# Get from: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Brave Search API (Trend Analysis)
# Get from: https://brave.com/search/api/
BRAVE_API_KEY=BSAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ========================================
# 🟡 ÖNERİLEN (Önemli Özellikler)
# ========================================

# Email Notifications (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=info@aihaberleri.org

# Unsplash (Image Fallback)
# Get from: https://unsplash.com/developers
UNSPLASH_ACCESS_KEY=your-unsplash-access-key

# ========================================
# 🟢 OPSİYONEL (Ekstra Özellikler)
# ========================================

# Firebase (Push Notifications)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Twitter Integration
TWITTER_APP_KEY=your-twitter-app-key
TWITTER_APP_SECRET=your-twitter-app-secret
TWITTER_ACCESS_TOKEN=your-twitter-access-token
TWITTER_ACCESS_SECRET=your-twitter-access-secret
TWITTER_HANDLE=@aihaberleriorg

# Facebook Integration
FACEBOOK_PAGE_ID=your-page-id
FACEBOOK_PAGE_ACCESS_TOKEN=your-page-access-token

# Additional Search APIs
TAVILY_API_KEY=your-tavily-key
EXA_API_KEY=your-exa-key

# Google AdSense
NEXT_PUBLIC_ADSENSE_CLIENT_ID=ca-pub-xxxxxxxxxxxxxxxx

# ========================================
# ⚙️ KONFIGÜRASYON (Defaults)
# ========================================

# Agent Configuration
AGENT_ENABLED=true
# OPTIMIZED: Always 1 article for efficiency
AGENT_MIN_ARTICLES_PER_RUN=1
AGENT_MAX_ARTICLES_PER_RUN=1
AGENT_MIN_INTERVAL_HOURS=6

# Site Configuration
NEXT_PUBLIC_SITE_URL=https://aihaberleri.org
NEXT_PUBLIC_SITE_NAME=AI Haberleri
NEXT_PUBLIC_SITE_DESCRIPTION=Yapay zeka dünyasındaki gelişmeleri yakından takip edin
CONTACT_EMAIL=info@aihaberleri.org

# Port Configuration (Coolify otomatik halleder, değiştirmeyin)
APP_PORT=3001

# ========================================
# 📝 NOTLAR
# ========================================

# 1. DATABASE_URL: Coolify PostgreSQL'in INTERNAL URL'ini kullan
#    Yanlış: postgresql://...@77.42.68.4:5435/...  (Public IP)
#    Doğru: postgresql://...@postgres:5432/...      (Internal hostname)

# 2. NEXTAUTH_SECRET: Güçlü olmalı (min 32 karakter)
#    Generate: openssl rand -base64 32

# 3. Firebase Private Key: Newline karakterleri (\n) korunmalı
#    Format: "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# 4. Environment Variable değiştirince:
#    Coolify Dashboard → Save → Redeploy (ZORUNLU!)

# 5. Secrets'ları asla Git'e commit etmeyin!
#    .gitignore'da .env dosyaları zaten ignore ediliyor
